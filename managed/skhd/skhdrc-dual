

# Move the focused Space to the other display. The wrapper creates a safe
# replacement first when macOS would otherwise leave the source display empty.
alt - x : $HOME/.config/skhd/yabai-run.sh --script move-space-to-other-display.sh

# Toggle every user Space and the default for future Spaces between float and
# automatic BSP tiling, using only the yabai build from this project.
alt - t : $HOME/.config/skhd/yabai-run.sh --script toggle-yabai-layout.sh

# ============================================================
# Keyboard-only layer
# ============================================================

# --- focus / cycle windows (works in float AND bsp) ---
alt - h : $HOME/.config/skhd/win-dir.sh focus west
alt - j : $HOME/.config/skhd/win-dir.sh focus south
alt - k : $HOME/.config/skhd/win-dir.sh focus north
alt - l : $HOME/.config/skhd/win-dir.sh focus east
alt - tab : $HOME/.config/skhd/yabai-run.sh -m window --focus next >/dev/null 2>&1

# --- move window (float) / swap window (bsp) ---
alt+shift - h : $HOME/.config/skhd/win-dir.sh move west
alt+shift - j : $HOME/.config/skhd/win-dir.sh move south
alt+shift - k : $HOME/.config/skhd/win-dir.sh move north
alt+shift - l : $HOME/.config/skhd/win-dir.sh move east

# --- resize window ---
fn - h : $HOME/.config/skhd/win-dir.sh resize west
fn - j : $HOME/.config/skhd/win-dir.sh resize south
fn - k : $HOME/.config/skhd/win-dir.sh resize north
fn - l : $HOME/.config/skhd/win-dir.sh resize east

# --- switch spaces ---
alt - 1 : $HOME/.config/skhd/yabai-run.sh -m space --focus 1 >/dev/null 2>&1
alt - 2 : $HOME/.config/skhd/yabai-run.sh -m space --focus 2 >/dev/null 2>&1
alt - 3 : $HOME/.config/skhd/yabai-run.sh -m space --focus 3 >/dev/null 2>&1
alt - 4 : $HOME/.config/skhd/yabai-run.sh -m space --focus 4 >/dev/null 2>&1
alt - 5 : $HOME/.config/skhd/yabai-run.sh -m space --focus 5 >/dev/null 2>&1
alt - 6 : $HOME/.config/skhd/yabai-run.sh -m space --focus 6 >/dev/null 2>&1
alt - 7 : $HOME/.config/skhd/yabai-run.sh -m space --focus 7 >/dev/null 2>&1
alt - 8 : $HOME/.config/skhd/yabai-run.sh -m space --focus 8 >/dev/null 2>&1
alt - 9 : $HOME/.config/skhd/yabai-run.sh -m space --focus 9 >/dev/null 2>&1

# --- cycle spaces (Raycast switch-to-next-space does not fire via hotkey) ---
alt - z : $HOME/.config/skhd/yabai-run.sh -m space --focus next >/dev/null 2>&1
alt - v : $HOME/.config/skhd/yabai-run.sh -m space --focus prev >/dev/null 2>&1

# --- send window to space (and follow it) ---
alt+shift - 1 : $HOME/.config/skhd/yabai-run.sh -m window --space 1 >/dev/null 2>&1 && $HOME/.config/skhd/yabai-run.sh -m space --focus 1 >/dev/null 2>&1
alt+shift - 2 : $HOME/.config/skhd/yabai-run.sh -m window --space 2 >/dev/null 2>&1 && $HOME/.config/skhd/yabai-run.sh -m space --focus 2 >/dev/null 2>&1
alt+shift - 3 : $HOME/.config/skhd/yabai-run.sh -m window --space 3 >/dev/null 2>&1 && $HOME/.config/skhd/yabai-run.sh -m space --focus 3 >/dev/null 2>&1
alt+shift - 4 : $HOME/.config/skhd/yabai-run.sh -m window --space 4 >/dev/null 2>&1 && $HOME/.config/skhd/yabai-run.sh -m space --focus 4 >/dev/null 2>&1
alt+shift - 5 : $HOME/.config/skhd/yabai-run.sh -m window --space 5 >/dev/null 2>&1 && $HOME/.config/skhd/yabai-run.sh -m space --focus 5 >/dev/null 2>&1
alt+shift - 6 : $HOME/.config/skhd/yabai-run.sh -m window --space 6 >/dev/null 2>&1 && $HOME/.config/skhd/yabai-run.sh -m space --focus 6 >/dev/null 2>&1
alt+shift - 7 : $HOME/.config/skhd/yabai-run.sh -m window --space 7 >/dev/null 2>&1 && $HOME/.config/skhd/yabai-run.sh -m space --focus 7 >/dev/null 2>&1
alt+shift - 8 : $HOME/.config/skhd/yabai-run.sh -m window --space 8 >/dev/null 2>&1 && $HOME/.config/skhd/yabai-run.sh -m space --focus 8 >/dev/null 2>&1
alt+shift - 9 : $HOME/.config/skhd/yabai-run.sh -m window --space 9 >/dev/null 2>&1 && $HOME/.config/skhd/yabai-run.sh -m space --focus 9 >/dev/null 2>&1

# --- window toggles ---
alt - f : $HOME/.config/skhd/yabai-run.sh -m window --toggle zoom-fullscreen >/dev/null 2>&1
alt - s : $HOME/.config/skhd/yabai-run.sh -m window --toggle float >/dev/null 2>&1

# --- display: move focused window to the next display (loops back around) ---
alt - right : $HOME/.config/skhd/cycle-window-display.sh >/dev/null 2>&1
