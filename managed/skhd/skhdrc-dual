

# Move the focused Space to the other display. The wrapper creates a safe
# replacement first when macOS would otherwise leave the source display empty.
alt - x : /bin/bash /Users/droy-/dev/yabai-macos27/scripts/move-space-to-other-display.sh

# Toggle every user Space and the default for future Spaces between float and
# automatic BSP tiling, using only the yabai build from this project.
alt - t : /bin/bash /Users/droy-/dev/yabai-macos27/scripts/toggle-yabai-layout.sh

# ============================================================
# Keyboard-only layer
# ============================================================

# --- focus / cycle windows (works in float AND bsp) ---
alt - h : /Users/droy-/.config/skhd/win-dir.sh focus west
alt - j : /Users/droy-/.config/skhd/win-dir.sh focus south
alt - k : /Users/droy-/.config/skhd/win-dir.sh focus north
alt - l : /Users/droy-/.config/skhd/win-dir.sh focus east
alt - tab : /Users/droy-/dev/yabai-macos27/bin/yabai -m window --focus next >/dev/null 2>&1

# --- move window (float) / swap window (bsp) ---
alt+shift - h : /Users/droy-/.config/skhd/win-dir.sh move west
alt+shift - j : /Users/droy-/.config/skhd/win-dir.sh move south
alt+shift - k : /Users/droy-/.config/skhd/win-dir.sh move north
alt+shift - l : /Users/droy-/.config/skhd/win-dir.sh move east

# --- resize window ---
fn - h : /Users/droy-/.config/skhd/win-dir.sh resize west
fn - j : /Users/droy-/.config/skhd/win-dir.sh resize south
fn - k : /Users/droy-/.config/skhd/win-dir.sh resize north
fn - l : /Users/droy-/.config/skhd/win-dir.sh resize east

